# Leave empty to use the deterministic local-template provider.
OPENAI_API_KEY=

# Any service implementing the OpenAI Chat Completions contract can be used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# If a configured remote provider fails or returns invalid JSON, use the local
# provider and report model=local-template. Set false to return HTTP 503 instead.
OPENAI_FALLBACK_ENABLED=true

APP_NAME=Story Forge AI Service
APP_VERSION=0.1.0
