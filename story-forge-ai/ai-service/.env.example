# Leave empty to use the deterministic local-template provider.
OPENAI_API_KEY=

# Any service implementing the OpenAI Chat Completions contract can be used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_CREATIVE_MODEL=gpt-4o-mini
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# If a configured remote provider fails or returns invalid JSON, use the local
# provider and report model=local-template. Set false to return HTTP 503 instead.
OPENAI_FALLBACK_ENABLED=true

APP_NAME=Story Forge AI Service
APP_VERSION=0.2.0

# Second-week asynchronous workflow transport.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUEST_STREAM=story:workflow:requests
REDIS_EVENT_STREAM=story:workflow:events
REDIS_CONSUMER_GROUP=story-workflow-workers
# Optional. Defaults to hostname-PID.
REDIS_CONSUMER_NAME=
