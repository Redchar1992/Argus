# Leave empty to use the deterministic local-template provider.
OPENAI_API_KEY=

# auto selects OpenAI-compatible only when OPENAI_API_KEY is present.
# Set ollama for a local /v1/chat/completions server; no API key is required.
MODEL_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Any service implementing the OpenAI Chat Completions contract can be used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_CREATIVE_MODEL=gpt-4o-mini
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# If a configured remote provider fails or returns invalid JSON, use the local
# provider and report model=local-template. Set false to return HTTP 503 instead.
OPENAI_FALLBACK_ENABLED=true

APP_NAME=Story Forge AI Service
APP_VERSION=0.3.0

# Second-week asynchronous workflow transport.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUEST_STREAM=story:workflow:requests
REDIS_EVENT_STREAM=story:workflow:events
REDIS_CONSUMER_GROUP=story-workflow-workers
# Optional. Defaults to hostname-PID.
REDIS_CONSUMER_NAME=

# Third-week chapter worker. The Docker image creates writable /data.
CHAPTER_COMMAND_STREAM=story:chapter:commands
CHAPTER_EVENT_STREAM=story:chapter:events
CHAPTER_CONSUMER_GROUP=story-chapter-workers
# Optional. Defaults to hostname-PID.
CHAPTER_CONSUMER_NAME=
CHAPTER_EVENT_MAXLEN=100000
CHAPTER_MAX_ATTEMPTS=3
CHAPTER_CHECKPOINT_DB=/data/chapter-checkpoints.sqlite
