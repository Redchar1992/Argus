# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Required for the mysql profile. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=45s

# Browser clients (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Week-two asynchronous workflow (disabled by default for zero-dependency local startup)
WORKFLOW_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
WORKFLOW_REQUEST_STREAM=story:workflow:requests
WORKFLOW_EVENT_STREAM=story:workflow:events
WORKFLOW_EVENT_GROUP=storyforge-backend
# Must be unique for each backend replica.
WORKFLOW_EVENT_CONSUMER=backend-1
WORKFLOW_POLL_TIMEOUT=2s
WORKFLOW_BATCH_SIZE=10
WORKFLOW_RECLAIM_IDLE=60s
WORKFLOW_RECLAIM_INTERVAL_MS=10000
WORKFLOW_RECLAIM_BATCH_SIZE=20

# MySQL profile only
MYSQL_URL=jdbc:mysql://localhost:3306/story_forge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
