# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Required for the mysql profile. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=45s

# Browser clients (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL profile only
MYSQL_URL=jdbc:mysql://localhost:3306/story_forge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
