# MySQL
MYSQL_DATABASE=story_forge
MYSQL_USER=story_forge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Required. Generate with: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb
AI_INTERNAL_API_KEY=
# Keep the HTTP AI service fail-closed outside local development.
AI_REQUIRE_INTERNAL_API_KEY=true

# Optional localhost bind/port overrides (container ports stay unchanged).
MYSQL_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=5173
PUBLIC_API_BASE_URL=http://localhost:8080
# Must match the browser origin above when FRONTEND_PORT is changed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
# Single-node pilot authentication throttling. Replace with a shared limiter
# before running more than one backend replica.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_TYPE=SLIDING
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW=1h
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_ENTRIES=20000
WORKFLOW_RECLAIM_INTERVAL_MS=10000
CHAPTER_RECLAIM_INTERVAL_MS=10000
CHAPTER_EVENT_MAXLEN=100000
CHAPTER_MAX_ATTEMPTS=3
CHAPTER_EVENT_RETENTION_PER_TASK=10000
CHAPTER_SSE_TIMEOUT_MS=1800000
EXPORT_DOWNLOAD_TTL_MINUTES=15
FINAL_REVIEW_MAX_CHARS=500000

# ModelProvider: auto, openai-compatible, ollama, or local.
# `auto` uses OpenAI-compatible when a key exists, otherwise local-template.
MODEL_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CREATIVE_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_ENABLED=true
# Production/pilot guardrail: require a real model call and disable fallback.
AI_REQUIRE_REMOTE_MODEL=false

# Optional operator-only funnel metrics endpoint. Generate with:
# openssl rand -hex 32
PILOT_METRICS_KEY=

# Optional thresholds used by deploy/pilot-healthcheck.sh.
REDIS_MEMORY_ALERT_PERCENT=90
WORKFLOW_STREAM_ALERT_LENGTH=1000
CHAPTER_DEAD_LETTER_ALERT_LENGTH=0

# Used only when MODEL_PROVIDER=ollama. Docker Desktop resolves host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Production exports may replace the local named volume with an S3/MinIO adapter.
# Keep credentials in Docker/Kubernetes secrets, never in frontend variables.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=story-forge-exports
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
