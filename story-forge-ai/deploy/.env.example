# MySQL
MYSQL_DATABASE=story_forge
MYSQL_USER=story_forge
MYSQL_PASSWORD=story_forge_dev
MYSQL_ROOT_PASSWORD=story_forge_root_dev

# Optional host-port overrides (container ports stay unchanged).
MYSQL_PORT=3306
REDIS_PORT=6379
AI_SERVICE_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
PUBLIC_API_BASE_URL=http://localhost:8080
# Must match the browser origin above when FRONTEND_PORT is changed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
WORKFLOW_RECLAIM_INTERVAL_MS=10000

# Optional OpenAI-compatible provider. Leave empty to use local-template.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CREATIVE_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
