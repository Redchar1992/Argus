# Public TLS endpoint. Point PUBLIC_HOST to this server before starting Caddy.
PUBLIC_HOST=story.example.com
ACME_EMAIL=ops@example.com
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
PUBLIC_API_BASE_URL=https://story.example.com
CORS_ALLOWED_ORIGINS=https://story.example.com
TZ=Asia/Shanghai

# Invite-only pilot gate. Generate a bcrypt hash, then keep the single quotes:
# docker run --rm caddy:2.11.4-alpine caddy hash-password --algorithm bcrypt --bcrypt-cost 10 --plaintext 'a-long-random-password'
# Store the generated value in single quotes, for example: '$2a$10$...'
PILOT_BASIC_AUTH_USER=pilot
PILOT_BASIC_AUTH_HASH=

# Database and internal service secrets. Generate every value independently:
# openssl rand -hex 32
MYSQL_DATABASE=story_forge
MYSQL_USER=story_forge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb
JWT_SECRET=
AI_INTERNAL_API_KEY=
PILOT_METRICS_KEY=

# Bind operational ports to loopback. Only Caddy exposes public 80/443.
MYSQL_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=5173

# A pilot must use a real remote provider and must not silently fall back to
# deterministic local templates.
MODEL_PROVIDER=openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CREATIVE_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_ENABLED=false
AI_REQUIRE_REMOTE_MODEL=true
AI_REQUIRE_INTERNAL_API_KEY=true

# Runtime limits and retention.
JWT_EXPIRATION=86400000
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_TYPE=SLIDING
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW=1h
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_ENTRIES=20000
WORKFLOW_RECLAIM_INTERVAL_MS=10000
CHAPTER_RECLAIM_INTERVAL_MS=10000
CHAPTER_EVENT_MAXLEN=100000
CHAPTER_MAX_ATTEMPTS=3
CHAPTER_EVENT_RETENTION_PER_TASK=10000
CHAPTER_SSE_TIMEOUT_MS=1800000
EXPORT_DOWNLOAD_TTL_MINUTES=15
FINAL_REVIEW_MAX_CHARS=500000

# Defaults target a single 4 GB / 2 vCPU pilot server. Raise these before
# increasing worker concurrency or running a local model.
MYSQL_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=192m
BACKEND_MEMORY_LIMIT=640m
AI_SERVICE_MEMORY_LIMIT=384m
AI_WORKER_MEMORY_LIMIT=384m
CHAPTER_WORKER_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=96m
CADDY_MEMORY_LIMIT=96m
MYSQL_CPU_LIMIT=1.0
REDIS_CPU_LIMIT=0.5
BACKEND_CPU_LIMIT=1.0
AI_SERVICE_CPU_LIMIT=0.75
AI_WORKER_CPU_LIMIT=0.75
CHAPTER_WORKER_CPU_LIMIT=1.0
FRONTEND_CPU_LIMIT=0.25
CADDY_CPU_LIMIT=0.25

# Optional generic JSON webhook invoked by pilot-healthcheck.sh on failure.
ALERT_WEBHOOK_URL=
REDIS_MEMORY_ALERT_PERCENT=90
WORKFLOW_STREAM_ALERT_LENGTH=1000
CHAPTER_DEAD_LETTER_ALERT_LENGTH=0
