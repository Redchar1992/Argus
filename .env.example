# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- Auth ---
# 32+ byte secret for signing JWTs. Generate with: openssl rand -base64 48
# SHARED across all services: auth-service signs with it; orchestrator, screening-tools
# and case-service validate incoming JWTs with the SAME secret (HS256 resource server).
ARGUS_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# --- Agent LLM provider ---
# 'local' (default, no key needed) or 'anthropic' (real Claude tool-use).
ARGUS_LLM_PROVIDER=local
# Only needed when ARGUS_LLM_PROVIDER=anthropic:
ARGUS_ANTHROPIC_API_KEY=
ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Trace store ---
# 'memory' (default) or 'mongo' (real NoSQL; requires SPRING_PROFILES_ACTIVE=mongo).
ARGUS_TRACE_STORE=memory

# --- Databases (only when using the 'postgres'/'mongo' profiles) ---
ARGUS_PG_URL=jdbc:postgresql://localhost:5432/argus
ARGUS_PG_USER=argus
ARGUS_PG_PASSWORD=argus
ARGUS_MONGO_URI=mongodb://localhost:27017/argus

# --- Inter-service URLs (defaults are fine for local) ---
ARGUS_TOOLS_URL=http://localhost:8083
ARGUS_CASE_URL=http://localhost:8084
