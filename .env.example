# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- Auth ---
# 32+ byte secret for signing JWTs. Generate with: openssl rand -base64 48
# SHARED across all services: auth-service signs with it; orchestrator, screening-tools
# and case-service validate incoming JWTs with the SAME secret (HS256 resource server).
ARGUS_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Optional OpenID Connect provider. The BFF performs Authorization Code + PKCE;
# auth-service independently verifies issuer, JWKS signature, audience, expiry and nonce.
ARGUS_OIDC_ENABLED=false
ARGUS_OIDC_ISSUER=https://identity.example.com
ARGUS_OIDC_AUDIENCE=argus-web

# Encrypt TOTP and future identity secrets. Production must replace this dev key.
# Rotation keeps old kid:key entries for reads and points PRIMARY at the new key.
ARGUS_IDENTITY_PRIMARY_KEY_ID=dev-v1
ARGUS_IDENTITY_KEYS=dev-v1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ARGUS_MFA_CHALLENGE_TTL_SECONDS=300
ARGUS_MFA_ENROLLMENT_TTL_SECONDS=600
ARGUS_MFA_MAXIMUM_ATTEMPTS=5
# HMAC pepper for stored recovery-code hashes; replace the shipped development value.
ARGUS_RECOVERY_PEPPER=YXJndXMtcmVjb3ZlcnktZGV2LXBlcHBlci1rZXktdjE=
# Temporary BFF-to-auth-service workload credential used on private Passkey material routes.
# Use a unique random value (32+ characters); authenticated TLS is configured separately.
ARGUS_INTERNAL_BFF_SECRET=change-me-to-a-random-bff-workload-secret

# --- Agent LLM provider ---
# 'local' (default, no key needed) or 'anthropic' (real Claude tool-use).
ARGUS_LLM_PROVIDER=local
# Only needed when ARGUS_LLM_PROVIDER=anthropic:
ARGUS_ANTHROPIC_API_KEY=
ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Trace store ---
# 'memory' (default) or 'mongo' (real NoSQL; requires SPRING_PROFILES_ACTIVE=mongo).
ARGUS_TRACE_STORE=memory

# --- Databases (only when using the 'postgres'/'mongo' profiles) ---
ARGUS_PG_URL=jdbc:postgresql://localhost:5432/argus
ARGUS_PG_USER=argus
ARGUS_PG_PASSWORD=argus
ARGUS_MONGO_URI=mongodb://localhost:27017/argus

# --- Inter-service URLs (defaults are fine for local) ---
ARGUS_TOOLS_URL=http://localhost:8083
ARGUS_CASE_URL=http://localhost:8084

# --- Identity BFF (Node/Fastify, browser-facing on /bff) ---
BFF_HOST=127.0.0.1
BFF_PORT=3001
ARGUS_AUTH_URL=http://127.0.0.1:8081
ARGUS_INVESTIGATION_URL=http://127.0.0.1:8082
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BFF_REQUEST_TIMEOUT_MS=5000
BFF_SESSION_TTL_SECONDS=3600
BFF_LOGIN_RATE_LIMIT_MAX=10
BFF_LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Development defaults to memory. Production startup requires redis so
# sessions and login limits are shared across BFF replicas.
BFF_SESSION_STORE=memory
BFF_REDIS_URL=redis://127.0.0.1:6379
BFF_REDIS_CONNECT_TIMEOUT_MS=1000
# Required for Redis sessions: base64-encoded 32-byte AES-256-GCM key.
# Generate with: openssl rand -base64 32
BFF_SESSION_ENCRYPTION_KEY=
# Development over HTTP only. Production startup rejects false.
BFF_COOKIE_SECURE=false
# Deterministic Playwright/local UI upstream only; production startup rejects true.
BFF_MOCK_UPSTREAM=false

# Optional OIDC relying party. Client secret may be blank for a public client.
BFF_OIDC_ENABLED=false
BFF_OIDC_ISSUER=https://identity.example.com
BFF_OIDC_CLIENT_ID=argus-web
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_REDIRECT_URI=http://localhost:3001/bff/auth/oidc/callback
BFF_OIDC_SCOPES=openid profile email
BFF_OIDC_SUCCESS_REDIRECT=/?auth=oidc_success
BFF_OIDC_ERROR_REDIRECT=/?auth=oidc_error
BFF_OIDC_TRANSACTION_TTL_SECONDS=300
BFF_MFA_CHALLENGE_TTL_SECONDS=300
BFF_MFA_REQUIRED_REDIRECT=/?auth=mfa_required

# WebAuthn / Passkeys. RP ID is a hostname only; Origin is the exact public SPA origin.
BFF_PASSKEY_ENABLED=true
BFF_WEBAUTHN_RP_ID=localhost
BFF_WEBAUTHN_RP_NAME=Argus
BFF_WEBAUTHN_ORIGIN=http://localhost:5173
BFF_WEBAUTHN_CEREMONY_TTL_SECONDS=300
