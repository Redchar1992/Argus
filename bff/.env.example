# The browser talks to this BFF through Vite's same-origin /bff proxy.
BFF_HOST=127.0.0.1
BFF_PORT=3001

# Java upstreams. The BFF alone sees the JWT returned by auth-service.
ARGUS_AUTH_URL=http://127.0.0.1:8081
ARGUS_INVESTIGATION_URL=http://127.0.0.1:8082

# Exact browser origins accepted on state-changing requests.
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BFF_REQUEST_TIMEOUT_MS=5000
BFF_SESSION_TTL_SECONDS=3600
BFF_LOGIN_RATE_LIMIT_MAX=10
BFF_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# In development, memory is the zero-infrastructure default. Production
# requires Redis for shared sessions and distributed login rate limiting.
BFF_SESSION_STORE=memory
BFF_REDIS_URL=redis://127.0.0.1:6379
BFF_REDIS_CONNECT_TIMEOUT_MS=1000
# Required when BFF_SESSION_STORE=redis. Generate: openssl rand -base64 32
BFF_SESSION_ENCRYPTION_KEY=

# Set true behind HTTPS in production. Defaults to true when NODE_ENV=production.
BFF_COOKIE_SECURE=false

# Deterministic local/Playwright upstream. Never enable in a real deployment.
BFF_MOCK_UPSTREAM=false

# Optional OIDC Authorization Code + PKCE login. Client secret may be empty for
# public clients. Production requires HTTPS issuer and callback URLs.
BFF_OIDC_ENABLED=false
BFF_OIDC_ISSUER=https://identity.example.com
BFF_OIDC_CLIENT_ID=argus-web
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_REDIRECT_URI=http://localhost:5173/bff/auth/oidc/callback
BFF_OIDC_SCOPES=openid profile email
BFF_OIDC_SUCCESS_REDIRECT=/?auth=oidc_success
BFF_OIDC_ERROR_REDIRECT=/?auth=oidc_error
BFF_OIDC_TRANSACTION_TTL_SECONDS=300
BFF_MFA_CHALLENGE_TTL_SECONDS=300
BFF_MFA_REQUIRED_REDIRECT=/?auth=mfa_required
