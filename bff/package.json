{
  "name": "argus-identity-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Same-origin identity BFF for the Argus analyst console",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "^5.6.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
