{
  "name": "argus-identity-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Same-origin identity BFF for the Argus analyst console",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "openid-client": "^6.8.8",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
