# Reference input for `docker compose --env-file .env.production -f compose.production.yml ...`.
# Copy this file to `.env.production`, replace every value, and never commit that file.
ARGUS_REGION=local-prod
ARGUS_PUBLIC_HOST=argus.example.com
ARGUS_PUBLIC_ORIGIN=https://argus.example.com
ARGUS_ANALYST_PORT=8088
ARGUS_ADMIN_PORT=8089

ARGUS_PG_USER=replace-me
ARGUS_PG_PASSWORD=replace-with-a-random-password
ARGUS_MONGO_USER=replace-me
ARGUS_MONGO_PASSWORD=replace-with-a-random-password
ARGUS_REDIS_PASSWORD=replace-with-a-random-password

# Temporary HS256 configuration; milestone 2 replaces this with an asymmetric key ring.
ARGUS_JWT_SECRET=replace-with-openssl-rand-base64-48
ARGUS_IDENTITY_PRIMARY_KEY_ID=prod-v1
ARGUS_IDENTITY_KEYS=prod-v1:replace-with-openssl-rand-base64-32
ARGUS_RECOVERY_PEPPER=replace-with-openssl-rand-base64-48
ARGUS_INTERNAL_BFF_SECRET=replace-with-at-least-32-random-characters
ARGUS_TLS_KEYSTORE_PASSWORD=replace-with-the-generated-keystore-password

BFF_ENCRYPTION_PRIMARY_KEY_ID=prod-v1
BFF_ENCRYPTION_KEYS=prod-v1:replace-with-openssl-rand-base64-32
BFF_METRICS_TOKEN=replace-with-at-least-32-random-characters

ARGUS_ANTHROPIC_API_KEY=replace-with-a-real-provider-key
ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6
